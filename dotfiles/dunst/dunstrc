[global]
    font = Iosevka Nerd Font 10
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = true
    indicate_hidden = yes
    shrink = no
    transparency = 0
    separator_height = 1
    padding = 12
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#8b0000"
    separator_color = frame
    sort = yes
    idle_threshold = 120

[urgency_low]
    background = "#1a1a1a"
    foreground = "#dcdcdc"
    timeout = 4

[urgency_normal]
    background = "#1a1a1a"
    foreground = "#dcdcdc"
    timeout = 6

[urgency_critical]
    background = "#8b0000"
    foreground = "#0a0a0a"
    timeout = 0

[ Lain_Welcome ]
    appname = "LainRice"
    summary = "Добро пожаловать в Wired"
    format = "<b>玲音</b>\nPresent day. Present time. HAHAHAHA."
    timeout = 10
    background = "#0a0a0a"
    foreground = "#7fd4d4"
    frame_color = "#7fd4d4"